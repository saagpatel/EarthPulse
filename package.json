{
  "name": "earthpulse",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "scripts": {
    "preflight": "bash ./scripts/preflight.sh",
    "preflight:ci": "bash ./scripts/preflight.sh --ci",
    "dev": "pnpm exec vite",
    "dev:lean": "bash ./scripts/lean-dev.sh",
    "check:artifacts": "bash ./scripts/check-tracked-artifacts.sh",
    "prebuild": "pnpm check:artifacts",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.app.json",
    "build": "pnpm run typecheck && pnpm exec vite build",
    "clean": "pnpm clean:heavy",
    "clean:heavy": "bash ./scripts/clean-heavy-artifacts.sh",
    "clean:full-local": "bash ./scripts/clean-full-local.sh",
    "clean:artifacts": "pnpm clean:heavy && find . -name '.DS_Store' -type f -delete",
    "clean:deep": "pnpm clean:full-local",
    "lint": "pnpm exec eslint .",
    "test:unit": "pnpm exec vitest run",
    "test:coverage": "pnpm exec vitest run --coverage && node scripts/quality/check-critical-coverage.mjs",
    "test:e2e": "pnpm exec playwright test",
    "test:rust": "CARGO_TARGET_DIR=/tmp/earthpulse-cargo-target cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "pnpm test:unit && pnpm test:rust",
    "preview": "pnpm exec vite preview",
    "prepare": "pnpm exec husky",
    "commit": "pnpm exec cz",
    "commitlint": "pnpm exec commitlint",
    "git:guard:branch": "bash scripts/git/guard-branch.sh",
    "git:guard:no-main-push": "bash scripts/git/guard-no-main-push.sh",
    "git:guard:atomic": "bash scripts/git/guard-atomic.sh",
    "git:guard:generated": "bash scripts/git/guard-generated.sh",
    "git:guard:large-files": "bash scripts/git/guard-large-files.sh",
    "git:guard:secrets": "bash scripts/git/guard-secrets.sh",
    "git:guard:all": "pnpm git:guard:branch && pnpm git:guard:atomic && pnpm git:guard:generated && pnpm git:guard:large-files && pnpm git:guard:secrets",
    "git:commit:propose": "node scripts/git/propose-commit-message.mjs",
    "git:session:save": "bash scripts/git/session-save.sh",
    "git:session:resume": "bash scripts/git/session-resume.sh",
    "pr:notes": "bash scripts/git/generate-pr-notes.sh",
    "perf:bundle": "node scripts/perf/bundle-report.mjs",
    "perf:build": "node scripts/perf/measure-build-time.mjs",
    "perf:assets": "bash scripts/perf/check-assets.sh",
    "perf:memory": "node --expose-gc scripts/perf/memory-smoke.mjs",
    "perf:lhci": "pnpm exec lhci autorun --config=lighthouserc.json",
    "perf:lhci:prod": "pnpm exec lhci autorun --config=.lighthouserc.production.json",
    "perf:baseline:capture": "node scripts/perf/capture-baselines.mjs",
    "perf:summary": "node scripts/perf/summarize.mjs",
    "version:check": "node scripts/ci/check-version-sync.mjs",
    "lint-staged": "pnpm exec lint-staged"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "uplot": "^1.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@tauri-apps/cli": "^2.11.4",
    "@vitest/coverage-v8": "^3.2.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "7.3.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@lhci/cli": "^0.15.1",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "jsdom": "^29.1.1",
    "vitest": "^3.2.6"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,css,scss,yml,yaml}": [
      "prettier --write"
    ]
  }
}
